#!/usr/bin/env bash

set -e

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

# Homebrew. Work Macs are managed by Workbrew, which refuses plain `brew`
# calls that don't go through its wrapper, so prefer that when it exists.
# Personal Macs don't have /opt/workbrew and fall through to plain Homebrew.
if [[ -x /opt/workbrew/bin/brew ]]; then
  BREW=/opt/workbrew/bin/brew
elif [[ -x /opt/homebrew/bin/brew ]]; then
  BREW=/opt/homebrew/bin/brew
else
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  BREW=/opt/homebrew/bin/brew
fi
# Newer Homebrew refuses formulae from third-party taps until they are trusted
# (stored per user, so a fresh Mac needs this too). Only trust yabai, not the
# whole tap.
"${BREW}" trust --formula asmvik/formulae/yabai
"${BREW}" bundle --file="${BASEDIR}/Brewfile"

git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DOTBOT_DIR}"

"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"

# Install the node version pinned in mise/global.toml
/opt/homebrew/bin/mise install --yes

# Start yabai (used by fw in zshrc.d/windows.zsh) as a login service. The
# first run needs Accessibility permission, see README. If it is already
# running, leave it.
/opt/homebrew/bin/yabai --start-service 2>/dev/null || true
