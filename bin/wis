#!/usr/bin/env bash
# wis — work items in iwoca/de-lending/project-management, like mrs for MRs.
#
#   wis              vim-style picker (fzf) of open work items assigned to you
#   wis -a           ...everyone's, not just yours
#   wis -c           ...closed ones too
#   wis -l <label>   ...with a label; "funding-requirements-v2" means project::funding-requirements-v2
#   wis -s <text>    ...matching text in the title or description
#   wis -p           plain printout grouped by status (default when not a TTY)
#   wis -w           plain printout, refreshed every 60s
#   wis <iid>        one work item in full: status, children, MRs, description, latest comments
#   wis status <iid> [status]   set its status, e.g. "In progress"; picks from a list if none given
#   wis assign <iid> assign it to you, or unassign you if it already is
#
# Picker keys:
#   j/k  down/up     g/G  top/bottom     ctrl-d/u  half page
#   o/enter  open in browser             y  copy URL
#   p  toggle preview                    r  reload
#   m  switch between yours and everyone's
#   s  set status                        a  assign to me / unassign me
#                                        (stays in your list until r/m, so a again undoes it)
#   /  search (enter keeps filter, esc clears)    q/esc  quit
set -euo pipefail

self=$(realpath "$0")
project=iwoca/de-lending/project-management
mine=1 closed= label= search= out=tui cmd=
[[ ${1:-} == status || ${1:-} == assign ]] && { cmd=$1; shift; }
[[ -t 1 ]] || out=plain
while getopts "acl:s:pwLP" opt; do
  case $opt in
    a) mine= ;;
    c) closed=1 ;;
    l) label=$OPTARG; [[ $label == *::* ]] || label="project::$label" ;;
    s) search=$OPTARG ;;
    p) out=plain ;;
    w) out=watch ;;
    L) out=lines ;;   # internal: fzf input
    P) out=preview ;; # internal: fzf preview, takes <iid>
    *) sed -n '2,22p' "$0"; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
[[ ${1:-} =~ ^[0-9]+$ ]] && out=preview

# The filters again, for the picker's reload bindings.
filters() {
  local f=()
  [[ -n $closed ]] && f+=(-c)
  [[ -n $label ]] && f+=(-l "$label")
  [[ -n $search ]] && f+=(-s "$search")
  # macOS bash 3.2 treats an empty array as unbound under set -u.
  [[ ${#f[@]} -gt 0 ]] && printf '%q ' "${f[@]}"
  return 0
}

fetch() {
  # Only the filters that are set go in: GitLab reads a list holding null as "match nothing".
  local f='first: 100, sort: UPDATED_DESC' vars='$fullPath: ID!' args=(-f fullPath="$project")
  if [[ -n $mine ]]; then
    f+=', assigneeUsernames: [$assignee]' vars+=', $assignee: String!'
    args+=(-f assignee="$(glab api user | jq -r .username)")
  fi
  [[ -n $label ]] && { f+=', labelName: [$label]' vars+=', $label: String!'; args+=(-f label="$label"); }
  [[ -n $search ]] && { f+=', search: $search' vars+=', $search: String!'; args+=(-f search="$search"); }
  [[ -z $closed ]] && f+=', state: opened'
  glab api graphql "${args[@]}" -f query='
    query('"$vars"') {
      project(fullPath: $fullPath) { workItems('"$f"') { nodes {
        iid title state webUrl updatedAt workItemType { name }
        widgets { type
          ... on WorkItemWidgetStatus { status { name category } }
          ... on WorkItemWidgetAssignees { assignees { nodes { username } } }
          ... on WorkItemWidgetLabels { labels { nodes { title } } }
          ... on WorkItemWidgetHierarchy { parent { iid } }
        }
      } } } }'
}

# Shared jq helpers for both renderers.
jq_defs='
  def c($code): "\u001b[\($code)m";
  def r: c("0");
  def dim: c("2");
  def pad($n): . + (" " * ([$n - length, 0] | max));
  def trunc($n): if length > $n then .[:$n-1] + "…" else . end;
  def ago:
    (now - (sub("\\.[0-9]+";"") | fromdateiso8601)) as $s
    | if $s < 60 then "now"
      elif $s < 3600 then "\($s/60|floor)m"
      elif $s < 86400 then "\($s/3600|floor)h"
      else "\($s/86400|floor)d" end;
  def w($t): [.widgets[]? | select(.type == $t)][0] // {};
  def statusname: (w("STATUS").status.name) // (if .state == "CLOSED" then "Done" else "To do" end);
  def category: (w("STATUS").status.category) // (if .state == "CLOSED" then "done" else "to_do" end);
  def statuscolor:
    {"in_progress": "34", "triage": "33", "to_do": "2", "done": "32", "canceled": "2;9"}[category] // "2";
  def statusorder:
    ({"in_progress": 0, "triage": 1, "to_do": 2, "done": 3, "canceled": 4}[category] // 2) * 100
    + ({"In progress": 0, "Reviewing": 1, "Waiting on requester": 2, "Ready": 0, "To do": 1, "On hold": 2}[statusname] // 5);
  def status: c(statuscolor) + (statusname | pad(11)) + r;
  def assignees: [w("ASSIGNEES").assignees.nodes[]?.username] | join(" ");
  # A fixed-width column, "—" when nobody is assigned.
  def assigneecol: assignees | if . == "" then dim + ("—" | pad(14)) + r else c("36") + (trunc(14) | pad(14)) + r end;
  def labels: [w("LABELS").labels.nodes[]?.title | sub("^project::"; "")] | join(" ");
  def parent: w("HIERARCHY").parent.iid // null | if . then dim + "↑#\(.)" + r else "" end;
  # The title column, with the type in front for anything that is not an issue. Both are
  # cut and padded together so the columns after it line up.
  def titlecell($tw):
    (.workItemType.name | if . == "Issue" then "" else "[\(.)] " end) as $t
    | ($t + .title) | trunc($tw) | pad($tw)
    | if $t != "" and startswith($t) then dim + $t + r + .[($t | length):] else . end;
  def link($url): "\u001b]8;;\($url)\u001b\\\(.)\u001b]8;;\u001b\\";
  def items: .data.project.workItems.nodes | sort_by(statusorder);
'

render_plain() {
  local width=${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}
  fetch | jq -r --argjson width "$width" "$jq_defs"'
    (($width - 65) | if . < 20 then 20 else . end) as $tw
    | items
    | if length == 0 then "No work items." else
        group_by(statusname) | sort_by(.[0] | statusorder)[]
        | "\n" + c("1") + (.[0] | statusname) + r,
          (.[] | .webUrl as $u
               | "  \(("#" + .iid) | pad(5) | link($u)) \(titlecell($tw)) \(assigneecol) "
                 + dim + "\(.updatedAt | ago | pad(4)) \(labels)" + r
                 + " " + parent)
      end'
}

# Tab-separated for fzf: url, iid, display line.
render_lines() {
  local width=${FZF_COLUMNS:-${COLUMNS:-$(tput cols)}}
  fetch | jq -r --argjson width "$width" "$jq_defs"'
    (($width - 67) | if . < 20 then 20 else . end) as $tw
    | items[]
    | [.webUrl, .iid,
       "\(status) \(("#" + .iid) | pad(5)) \(titlecell($tw)) \(assigneecol) "
         + dim + "\(.updatedAt | ago | pad(4)) \(labels)" + r]
    | @tsv'
}

render_preview() {
  local iid=$1 width=${FZF_PREVIEW_COLUMNS:-${COLUMNS:-100}} json mrs notes
  json=$(glab api graphql -f fullPath="$project" -f iid="$iid" -f query='
    query($fullPath: ID!, $iid: String!) { project(fullPath: $fullPath) { workItems(iids: [$iid]) { nodes {
      iid title state webUrl createdAt description author { username } workItemType { name }
      widgets { type
        ... on WorkItemWidgetStatus { status { name category } }
        ... on WorkItemWidgetAssignees { assignees { nodes { username } } }
        ... on WorkItemWidgetLabels { labels { nodes { title } } }
        ... on WorkItemWidgetHierarchy {
          parent { iid title }
          children(first: 50) { nodes { iid title state widgets { type ... on WorkItemWidgetStatus { status { name category } } } } }
        }
      }
    } } } }')
  [[ $(jq '.data.project.workItems.nodes | length' <<<"$json") == 0 ]] && { echo "No work item #$iid."; exit 1; }
  mrs=$(glab api "projects/${project//\//%2F}/issues/$iid/related_merge_requests" 2>/dev/null || echo '[]')
  notes=$(glab api "projects/${project//\//%2F}/issues/$iid/notes?sort=desc&order_by=created_at&per_page=20" 2>/dev/null || echo '[]')
  jq -r --argjson width "$width" --argjson mrs "$mrs" "$jq_defs"'
    def row($k; $v): dim + ($k | pad(10)) + r + $v;
    def mrstate: {"merged": "32", "opened": "34", "closed": "2;9"}[.state] // "2";
    .data.project.workItems.nodes[0]
    | c("1") + .title + r,
      dim + "#\(.iid) · \(.workItemType.name) · \(.author.username) · opened \(.createdAt | ago) ago" + r,
      dim + .webUrl + r,
      "",
      row("Status"; status),
      row("Assignees"; assignees | if . == "" then dim + "none" + r else c("36") + . + r end),
      row("Labels"; labels | if . == "" then dim + "none" + r else . end),
      (w("HIERARCHY").parent // empty | row("Parent"; "#\(.iid) \(.title)")),
      (w("HIERARCHY").children.nodes // [] | select(length > 0)
        | row("Children"; ""), (.[] | "  \(status) #\(.iid) \(.title)")),
      ($mrs | select(length > 0)
        | row("MRs"; ""), (.[] | "  " + c(mrstate) + (.state | pad(7)) + r + " "
                            + (.references.full | sub("^iwoca/"; "")) + " " + .title)),
      dim + ("─" * $width) + r' <<<"$json"
  jq -r '.data.project.workItems.nodes[0].description // ""' <<<"$json" \
    | { CLICOLOR_FORCE=1 glow -s dark -w "$width" - 2>/dev/null || cat; }
  # The last three comments, newest last.
  jq -r --argjson width "$width" "$jq_defs"'
    [.[] | select(.system | not)] | .[:3] | reverse
    | if length == 0 then empty else
        dim + ("─" * $width) + r,
        (.[] | c("36") + .author.username + r + dim + " · \(.created_at | ago) ago" + r, .body, "")
      end' <<<"$notes"
}

enc=${project//\//%2F}

statuses() {
  glab api graphql -f fullPath="$project" -f query='
    query($fullPath: ID!) { namespace(fullPath: $fullPath) { workItemTypes(name: ISSUE) { nodes {
      widgetDefinitions { ... on WorkItemWidgetDefinitionStatus { allowedStatuses { id name } } }
    } } } }' | jq -r '.data.namespace.workItemTypes.nodes[0].widgetDefinitions[]
                      | select(.allowedStatuses) | .allowedStatuses[] | [.id, .name] | @tsv'
}

set_status() {
  local iid=${1:?usage: wis status <iid> [status]} name=${2:-} all id gid res
  all=$(statuses)
  if [[ -z $name ]]; then
    name=$(cut -f2 <<<"$all" | fzf --height=~16 --layout=reverse --border=rounded \
      --border-label=" Status for #$iid ") || return 0
  fi
  id=$(awk -F'\t' -v n="$name" 'tolower($2) == tolower(n) { print $1 }' <<<"$all")
  if [[ -z $id ]]; then
    echo "No status \"$name\". Pick one of:"; cut -f2 <<<"$all" | sed 's/^/  /'; return 1
  fi
  gid=$(glab api graphql -f fullPath="$project" -f iid="$iid" -f query='
    query($fullPath: ID!, $iid: String!) { project(fullPath: $fullPath) { workItems(iids: [$iid]) { nodes { id } } } }' \
    | jq -r '.data.project.workItems.nodes[0].id // empty')
  [[ -n $gid ]] || { echo "No work item #$iid."; return 1; }
  res=$(glab api graphql -f query="mutation { workItemUpdate(input: { id: \"$gid\", statusWidget: { status: \"$id\" } }) {
    errors workItem { widgets { ... on WorkItemWidgetStatus { status { name } } } } } }")
  jq -e '(.errors // .data.workItemUpdate.errors) | length == 0' <<<"$res" >/dev/null \
    || { jq -r '(.errors // .data.workItemUpdate.errors)[] | .message? // .' <<<"$res"; return 1; }
  echo "#$iid is now $(jq -r '[.data.workItemUpdate.workItem.widgets[] | .status.name? // empty][0]' <<<"$res")"
}

assign() {
  local iid=${1:?usage: wis assign <iid>} me ids msg
  me=$(glab api user | jq -r .id)
  ids=$(glab api "projects/$enc/issues/$iid" | jq -c '[.assignees[].id]')
  if jq -e --argjson me "$me" 'index($me)' <<<"$ids" >/dev/null; then
    ids=$(jq -c --argjson me "$me" '. - [$me]' <<<"$ids")
    msg="Unassigned you from #$iid"
  else
    ids=$(jq -c --argjson me "$me" '. + [$me]' <<<"$ids")
    msg="Assigned #$iid to you"
  fi
  # A JSON body, as glab's -f can't send a list.
  jq -n --argjson ids "$ids" '{assignee_ids: $ids}' \
    | glab api -X PUT "projects/$enc/issues/$iid" -H 'Content-Type: application/json' --input - >/dev/null
  echo "$msg"
}

tui() {
  local nav='j,k,g,G,o,y,p,r,m,s,a,q,/' f reload
  f=$(filters)
  reload="reload($self -L $f \$([[ \$FZF_BORDER_LABEL == *Everyone* ]] && echo -a))"
  local border=' Assigned to me '
  [[ -z $mine ]] && border=' Everyone '
  render_lines | fzf --ansi --no-sort --layout=reverse --no-input \
    --delimiter='\t' --with-nth=3 --border=rounded --border-label="$border" \
    --header='o open · y copy · p preview · s status · a assign · r reload · m mine/everyone · / search · q quit' \
    --preview="$self -P {2}" --preview-window='right,55%,wrap,hidden,<160(down,65%,wrap,hidden)' \
    --bind="j:down,k:up,g:first,G:last,ctrl-d:half-page-down,ctrl-u:half-page-up" \
    --bind="o:execute-silent(open {1})" \
    --bind="y:execute-silent(printf %s {1} | pbcopy)+bell" \
    --bind="p:toggle-preview,q:abort" \
    --bind="r:$reload" \
    --bind="s:execute($self status {2})+$reload+refresh-preview" \
    --bind="a:execute-silent($self assign {2})+refresh-preview+transform:[[ \$FZF_BORDER_LABEL == *Everyone* ]] && echo '$reload'" \
    --bind="m:transform:[[ \$FZF_BORDER_LABEL == *Everyone* ]] \
      && echo 'reload($self -L $f)+change-border-label( Assigned to me )' \
      || echo 'reload($self -L -a $f)+change-border-label( Everyone )'" \
    --bind="/:show-input+unbind($nav)" \
    --bind="enter:transform:[[ \$FZF_INPUT_STATE == enabled ]] && echo 'hide-input+rebind($nav)' || echo 'execute-silent(open {1})'" \
    --bind="esc:transform:[[ \$FZF_INPUT_STATE == enabled ]] && echo 'clear-query+hide-input+rebind($nav)' || echo abort" \
    >/dev/null || true
}

case $cmd in
  status) set_status "$@"; exit ;;
  assign) assign "$@"; exit ;;
esac

case $out in
  tui) tui ;;
  plain) render_plain ;;
  lines) render_lines ;;
  preview) render_preview "$1" ;;
  watch) while true; do o=$(render_plain); clear; printf '%s\n' "$o"; sleep 60; done ;;
esac
